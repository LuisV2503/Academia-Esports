@page
@model front_academia.Pages.IndexModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="row justify-content-center">
    <div class="col-md-5">

        @if (ViewData.ContainsKey("Mensaje"))
        {
            <div class="alert alert-danger" role="alert">
                @ViewData["Mensaje"]
            </div>
        }

        @if (!Model.EstaLogueado)
        {
            <h2 class="text-center mb-4">Iniciar sesión</h2>

            <form method="post">
                <div class="form-group mb-3">
                    <label class="control-label">
                        Correo:
                    </label>
                    <input asp-for="@Model.Correo"
                           class="form-control" />
                </div>
                <div class="form-group mb-3">
                    <label class="control-label">
                        Contraseña:
                    </label>
                    <input type="password"
                           asp-for="@Model.Contrasena"
                           class="form-control" />
                </div>

                <input type="submit"
                       value="Limpiar"
                       asp-page-handler="BtClean"
                       class="btn btn-secondary" />
                <input type="submit"
                       value="Entrar"
                       asp-page-handler="BtEnter"
                       class="btn btn-primary" />
            </form>
        }
        else
        {
            <div class="text-center">
                <h1 class="display-4">
                    Bienvenido
                </h1>
                <h4>@Model.NombreUsuario</h4>
                <p>Rol: @Model.RolUsuario</p>

                <form method="post">
                    <input type="submit"
                           value="Cerrar sesión"
                           asp-page-handler="BtClose"
                           class="btn btn-secondary" />
                </form>
            </div>
        }

    </div>
</div>
