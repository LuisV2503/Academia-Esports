@page
@model front_academia.Pages.Ventanas.PersonasModel
@{
    ViewData["Title"] = "Personas";
}

<div class="text-center">
    <h1 class="display-4">Personas</h1>

    <table>
        <tr>
            <th>Id</th>
            <th>Nombre</th>
            <th>Nacionalidad</th>
            <th>Fecha de Nacimiento</th>
            <th>Valor Sueldo</th>

        </tr>

        @if (Model != null && Model.Lista != null)
        {
            foreach (var elemento in Model.Lista)
            {
                <tr>
                    <td>@elemento.Id</td>
                    <td>@elemento.Nombre</td>
                    <td>@elemento.Nacionalidad</td>
                    <td>@elemento.FechaNacimiento</td>
                    <td>@elemento._sueldo?.Valor</td>
                </tr>
            }
        }

                
    </table>

</div>
