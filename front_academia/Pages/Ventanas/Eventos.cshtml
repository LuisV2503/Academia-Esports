@page
@model front_academia.Pages.Ventanas.EventosModel
@{
    ViewData["Title"] = "Eventos";
}
<form method="post"
      enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Eventos</h1>

        <input type="submit"
               value="Buscar"
               class="btn btn-secondary"
               asp-page-handler="BtBuscar" />
        <input type="submit"
               value="Nuevo"
               class="btn btn-secondary"
               asp-page-handler="BtNuevo" />
        <input type="submit"
               value="Guardar"
               class="btn btn-secondary"
               asp-page-handler="BtGuardar" />
        <input id="flNombre"
               placeholder="Nombre"
               asp-for="@Model.Filtro!.Nombre" />

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml");
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input id="nmId"
                   type="hidden"
                   asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Eventos</h3>

                <label>
                    Nombre
                </label>
                <input id="nmNombre"
                       asp-for="@Model.Actual!.Nombre" />
                <br />

                <label>
                    Descripción
                </label>
                <input id="nmDescripcion"
                       asp-for="@Model.Actual!.Descripcion" />
                <br />

                <label>
                    Fecha de inicio
                </label>
                <input id="nmFechaIni"
                       asp-for="@Model.Actual!.FechaIni" />
                <br />

                <label>
                    Fecha de fin
                </label>
                <input id="nmFechaFin"
                       asp-for="@Model.Actual!.FechaFin" />
                <br />

                <label>
                    Activo
                </label>
                <input id="nmActivo"
                       asp-for="@Model.Actual!.Activo" />
                <br />

                <label>
                    Modalidad
                </label>
                <input id="nmModalidad"
                       asp-for="@Model.Actual!.Modalidad" />
                <br />

                <label>
                    Ciudad
                </label>
                <input id="nmCiudad"
                       asp-for="@Model.Actual!.Ciudad" />
                <br />

                <label>
                    Dirección
                </label>
                <input id="nmDireccion"
                       asp-for="@Model.Actual!.Direccion" />
                <br />

            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>Mensaje</h3>

                    <h4>
                        ¿Desea borrar la entidad...?
                    </h4>
                    <h6>
                        @Model.Actual!.Nombre
                    </h6>
                    <input type="submit"
                           value="Cancelar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBuscar" />
                    <input type="submit"
                           value="Borrar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>Id</th>
                        <th>Nombre</th>
                        <th>Descripción</th>
                        <th>Fecha de inicio</th>
                        <th>Fecha de fin</th>
                        <th>Activo</th>
                        <th>Modalidad</th>
                        <th>Ciudad</th>
                        <th>Dirección</th>
                        <th>Acción</th>
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.Id</td>
                                <td>@elemento.Nombre</td>
                                <td>@elemento.Descripcion</td>
                                <td>@elemento.FechaIni?.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@elemento.FechaFin?.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@elemento.Activo</td>
                                <td>@elemento.Modalidad</td>
                                <td>@elemento.Ciudad</td>
                                <td>@elemento.Direccion</td>
                                <td>
                                    <input type="submit"
                                           value="Editar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtEditar"
                                           asp-route-data="@elemento.Id" />
                                    <input type="submit"
                                           value="Borrar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtPregBorrar"
                                           asp-route-data="@elemento.Id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

    </div>
</form>
