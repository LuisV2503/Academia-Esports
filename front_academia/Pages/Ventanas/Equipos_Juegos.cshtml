@page
@model front_academia.Pages.Ventanas.Equipos_JuegosModel
@{
    ViewData["Title"] = "Equipos_Juegos";
}
<form method="post"
      enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Equipos_Juegos</h1>

        <input type="submit"
               value="Buscar"
               class="btn btn-secondary"
               asp-page-handler="BtBuscar" />
        <input type="submit"
               value="Nuevo"
               class="btn btn-secondary"
               asp-page-handler="BtNuevo" />
        <input type="submit"
               value="Guardar"
               class="btn btn-secondary"
               asp-page-handler="BtGuardar" />
        <input id="flNombre"
               placeholder="Nombre"
               asp-for="@Model.Filtro!._equipos!.Nombre" />

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml");
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input id="nmId"
                   type="hidden"
                   asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Equipos_Juegos</h3>

                <label>
                    Equipo
                </label>
                <select id="nmEquipo"
                        asp-for="@Model.Actual!.Equipo"
                        asp-items="Model.ListaEquipo">
                    <option value="">-- Seleccione --</option>
                </select>
                <br />

                <label>
                    Juego
                </label>
                <select id="nmJuego"
                        asp-for="@Model.Actual!.Juego"
                        asp-items="Model.ListaJuego">
                    <option value="">-- Seleccione --</option>
                </select>
                <br />

                <label>
                    Imagen (opcional, máx. 500 KB)
                </label>
                @if (!string.IsNullOrEmpty(Model.Actual!.Imagen))
                {
                    <br />
                    <img src="data:image/png;base64,@Model.Actual!.Imagen" style="max-height:120px;max-width:200px;" />
                }
                <br />
                <input id="flImagen"
                       type="file"
                       accept="image/*"
                       asp-for="FormFile" />
                <br />

            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>Mensaje</h3>

                    <h4>
                        ¿Desea borrar la entidad...?
                    </h4>
                    <h6>
                        @Model.Actual!._equipos?.Nombre,
                        @Model.Actual!._juegos?.Nombre
                    </h6>
                    <input type="submit"
                           value="Cancelar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBuscar" />
                    <input type="submit"
                           value="Borrar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>Id</th>
                        <th>Imagen</th>
                        <th>Equipo</th>
                        <th>Juego</th>
                        <th>Acción</th>
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.Id</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(elemento.Imagen))
                                    {
                                        <img src="data:image/png;base64,@elemento.Imagen" style="max-height:48px;max-width:80px;" />
                                    }
                                </td>
                                <td>@elemento._equipos?.Nombre</td>
                                <td>@elemento._juegos?.Nombre</td>
                                <td>
                                    <input type="submit"
                                           value="Editar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtEditar"
                                           asp-route-data="@elemento.Id" />
                                    <input type="submit"
                                           value="Borrar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtPregBorrar"
                                           asp-route-data="@elemento.Id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

    </div>
</form>
