@page
@model front_academia.Pages.Ventanas.AuditoriasModel
@{
    ViewData["Title"] = "Auditorias";
}
<form method="post"
      enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Auditorías</h1>

        <input type="submit"
               value="Buscar"
               class="btn btn-secondary"
               asp-page-handler="BtBuscar" />
        <input id="flDescripcion"
               placeholder="Descripción"
               asp-for="@Model.Filtro!.Descripcion" />

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml");
        }

        <div class="containers_vn panel panel-default">
            <table class="tb_data table table-striped table-bordered table-hover">
                <tr>
                    <th>Id</th>
                    <th>Fecha</th>
                    <th>Usuario</th>
                    <th>Descripción</th>
                </tr>
                @if (Model != null && Model.Lista != null)
                {
                    foreach (var elemento in Model.Lista)
                    {
                        <tr>
                            <td>@elemento.Id</td>
                            <td>@elemento.Fecha?.ToString("dd/MM/yyyy HH:mm:ss")</td>
                            <td>@elemento._usuario?.Nombre</td>
                            <td>@elemento.Descripcion</td>
                        </tr>
                    }
                }
            </table>
        </div>

    </div>
</form>
